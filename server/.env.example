# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
PORT=3000

# Browser origin allowed to call the API (the login cookie is sent to it).
CLIENT_ORIGIN="http://localhost:5173"

# Secret that signs the session cookie. Choose your own long random value.
# Optional for local development; required when NODE_ENV=production.
# SESSION_SECRET=""

# Optional: initial password used by `npm run prisma:seed` (default ChangeMe123).
# SEED_INITIAL_PASSWORD=""
